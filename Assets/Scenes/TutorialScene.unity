--- !u!114 &1507158599
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1507158593}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9ae9f44512c5f19499674c24cc8eea95, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  storyText: {fileID: 1648301621}
  nextButton: {fileID: 1189197015}
  sentences:
  - "\uB2F9\uC2E0\uC740 \uB9CC\uB144\uC5D0 \uD55C \uBC88\\n \uC5F4\uB9AC\uB294 \uC2E0\uB4E4\uC758
    \uC804\uC7A5\uC5D0 \\n\uB3C4\uCC29\uD55C \uC2E0\uB4E4 \uC911\uC5D0\\n \uD55C\uBA85\uC785\uB2C8\uB2E4."
  - "\uC774 \uC804\uC7A5\uC758 \uADDC\uCE59\uC740\\n\uAC04\uB2E8\uD569\uB2C8\uB2E4.
    \uBC1C\uC0AC\uB300\uB97C \uD1B5\uD574 \uC6B0\uC8FC\uC758 \uC911\uC2EC\uC73C\uB85C\\n\uD589\uC131\uC744
    \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
  - "\uD589\uC131\uC740 \uC190\uC73C\uB85C \uC7A1\uC544,\\n\uB4A4\uB85C \uB2F9\uAE34
    \uB4A4 \uC190\uC744\\n\uB193\uC73C\uBA74 \uBC1C\uC0AC\uB418\uBA70"
  - "\uB2F9\uC2E0\uC740 \uC88C\uC6B0\uB85C\\n\uC790\uC720\uB86D\uAC8C \uC774\uB3D9\uC774\\n\uAC00\uB2A5\uD569\uB2C8\uB2E4.\\n(\uD2B8\uB9AC\uAC70
    \uBC84\uD2BC \uBC0F\\n\uC88C\uCE21 \uC870\uC774\uC2A4\uD2F1 \uC0AC\uC6A9)"
  - "\uADF8\uB7EC\uBA74 \uBC1C\uC0AC\uB41C \uD589\uC131\uC740 \uC6B0\uC8FC\uC758
    \uC911\uC2EC\uC5D0 \uC874\uC7AC\uD558\uB294 \uC911\uB825\uC5D0 \uC601\uD5A5\uC744
    \uBC1B\uC544\\n\uC911\uC2EC \uC8FC\uBCC0\uC5D0 \uC704\uCE58\uD569\uB2C8\uB2E4."
  - "\uADF8\uB7EC\uB2E4 \uAC19\uC740 \uD589\uC131\uB07C\uB9AC \uB9CC\uB098\uAC8C
    \uB418\uBA74, \uC0C8\uB85C\uC6B4\\n\uD589\uC131\uC73C\uB85C \uD569\uCCD0\uC9C0\uBA70\\n\uC810\uC218\uB97C
    \uD68D\uB4DD\uD569\uB2C8\uB2E4."
  - "\uB2E8, \uD589\uC131\uC774 \uC6B0\uC8FC\uC758 \uC911\uC2EC \uBC16\uC73C\uB85C
    \uB098\uAC00\uAC8C \uB420 \uACBD\uC6B0, \uAC8C\uC784\uC774 \uC885\uB8CC\uB418\uBA70
    \uC2DC\uAC04\uACFC \uC810\uC218\uAC00 \uAE30\uB85D\uB429\uB2C8\uB2E4."
  - "\uCD5C\uB300\uD55C \uC624\uB79C \uC2DC\uAC04\uB3D9\uC548 \uC0B4\uC544\uB0A8\uC544,
    \uB192\uC740 \uC810\uC218\uB97C \uD68D\uB4DD\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
  - "\uB610\uD55C, \uAC8C\uC784\uC744 \uBC29\uD574\uD558\uB294 \uC704\uC131\uC774
    \uC6B0\uC8FC\uC758 \uC911\uC2EC\uC744 \uAE30\uC900\uC73C\uB85C \uACF5\uC804\uD558\uBBC0\uB85C\\n\uC870\uC2EC\uD558\uC2DC\uAE38
    \uBC14\uB78D\uB2C8\uB2E4."
